parameters:
    level: 8
    paths:
        - src/
        - tests/
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # 忽略测试中的动态调用 - PHPUnit 测试框架的正常使用模式
        - '#Dynamic call to static method PHPUnit\\Framework\\Assert::(assertTrue|assertFalse|assertNull|assertSame|assertEquals|assertInstanceOf)#'
        # 忽略测试中的类型窄化断言
        - '#Call to method PHPUnit\\Framework\\Assert::(assertTrue|assertFalse|assertNotNull|assertInstanceOf|assertSame)\(\) with .+ will always evaluate to (true|false)\.#'

includes:
    - ../../vendor/phpstan/phpstan-phpunit/extension.neon
    - ../../vendor/phpstan/phpstan-webmozart-assert/extension.neon
    - ../../vendor/phpstan/phpstan-strict-rules/rules.neon
    - ../../vendor/phpstan/phpstan-deprecation-rules/rules.neon
    # 临时排除 CognitiveComplexity 插件，等待插件修复 PHP 8.4 兼容性问题
    # - ../../vendor/tomasvotruba/cognitive-complexity/config/extension.neon